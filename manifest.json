{
  "experiment": "O-LONG",
  "title": "Adaptive Action Chunking (AAC vs DUAC) on Long-Horizon Tasks with pi0.5",
  "primary_backbone": "pi05",
  "primary_benchmark": "libero_10",
  "skip_libero_pro": true,
  "seed": 7,
  "trials_per_task": 50,
  "checkpoints": {
    "pi05_libero": "checkpoints/openpi/openpi-assets/checkpoints/pi05_libero",
    "paligemma_tokenizer": "checkpoints/openpi/big_vision/paligemma_tokenizer.model"
  },
  "runs": [
    {
      "id": "A1_duac_libero10",
      "method": "duac",
      "backbone": "pi05",
      "suite": "libero_10",
      "perturbation": "clean",
      "path": "outputs/pi05/libero_10/duac",
      "expected_episodes": 500,
      "require_state_bank": true,
      "require_subgoals": true
    },
    {
