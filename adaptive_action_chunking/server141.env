#!/usr/bin/env bash
# Environment variables for running O-LONG directly with local virtualenvs (.venv-openpi & .venv-libero)
export AAC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WORKSPACE_ROOT="$(cd "${AAC_ROOT}/.." && pwd)"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-${WORKSPACE_ROOT}/.cache/duac}"
export OPENPI_DATA_HOME="${OPENPI_DATA_HOME:-${WORKSPACE_ROOT}/checkpoints/openpi}"
export LIBERO_CONFIG_PATH="${LIBERO_CONFIG_PATH:-${WORKSPACE_ROOT}/.libero}"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
export PYOPENGL_PLATFORM="${PYOPENGL_PLATFORM:-egl}"
export XLA_PYTHON_CLIENT_PREALLOCATE="${XLA_PYTHON_CLIENT_PREALLOCATE:-false}"   # không chiếm trước GPU (task3010 mục 2.1), cho phép 2 server π0.5 (~9 GB mỗi cái)
export CUDA_VISIBLE_DEVICES="${CUDA_VISIBLE_DEVICES:-0}"
export OMP_NUM_THREADS="${OMP_NUM_THREADS:-8}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export PYTHONPATH="${WORKSPACE_ROOT}:${WORKSPACE_ROOT}/src:${WORKSPACE_ROOT}/flowbased_aac:${AAC_ROOT}:${WORKSPACE_ROOT}/external/aac-libero:${WORKSPACE_ROOT}/external/openpi/src:${WORKSPACE_ROOT}/external/openpi/packages/openpi-client/src:${WORKSPACE_ROOT}/external/LIBERO:${PYTHONPATH:-}"
mkdir -p "${XDG_CACHE_HOME}" "${OPENPI_DATA_HOME}" "${LIBERO_CONFIG_PATH}"
