#!/usr/bin/env bash
# Environment setup for adaptive_action_chunking (O-LONG pipeline)
export AAC_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export WORKSPACE_ROOT="$(cd "${AAC_ROOT}/.." && pwd)"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache/duac}"
export MUJOCO_GL="${MUJOCO_GL:-egl}"
export PYOPENGL_PLATFORM="${PYOPENGL_PLATFORM:-egl}"
export XLA_PYTHON_CLIENT_MEM_FRACTION="${XLA_PYTHON_CLIENT_MEM_FRACTION:-0.85}"
export PYTHONPATH="${AAC_ROOT}:${WORKSPACE_ROOT}:${WORKSPACE_ROOT}/external/aac-libero:${WORKSPACE_ROOT}/external/openpi/src:${WORKSPACE_ROOT}/external/openpi/packages/openpi-client/src:${WORKSPACE_ROOT}/external/LIBERO:${PYTHONPATH:-}"
mkdir -p "${XDG_CACHE_HOME}"

